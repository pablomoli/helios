# WebSocket Configuration
# Update with your backend server's address
WEBSOCKET_SERVER_URL=ws://localhost:5000

# OpenWeatherMap API
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Location (Update with your hackathon venue coordinates)
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
WEATHER_CACHE_TTL=900

# Dashboard Configuration
DASHBOARD_PORT=5000
FLASK_ENV=development
DEBUG_MODE=True

# System Settings
MOCK_DATA_MODE=False
LOG_LEVEL=INFO

# Porcupine Wake Word
# Get your access key at: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# Google Gemini API (for ADK Voice Agent)
# Get your API key at: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_google_api_key_here
