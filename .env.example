# MQTT Configuration (Raspberry Pi)
MQTT_BROKER_HOST=192.168.1.XXX
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60

# OpenWeatherMap API
# Get your free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Location (Update with your hackathon venue coordinates)
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
WEATHER_CACHE_TTL=900

# Dashboard Configuration
DASHBOARD_PORT=5000
FLASK_ENV=development
DEBUG_MODE=True

# System Settings
MOCK_DATA_MODE=False
LOG_LEVEL=INFO

# Porcupine Wake Word
# Get your access key at: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# Voice Agent (Google ADK)
ADK_PROJECT_ID=your_project_id_here

# Gemini Live API (Voice Chat)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Security
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://127.0.0.1:5000,http://127.0.0.1:5001

# Arduino Integration (Data Collection Agent)
ARDUINO_ENABLED=false
ARDUINO_PORT=/dev/ttyUSB0
ARDUINO_BAUD_RATE=9600
